---
import Text from './Text.astro';
import { fallback as t } from '../i18n/resources.js';
---
<section id="auth" class="auth-layout">
  <div class="intro">
    <Text as="p" class="eyebrow" k="intro.eyebrow" />
    <h1><Text k="intro.titleFirst" /><br /><Text k="intro.titleSecond" /></h1>
    <p class="lead"><Text k="intro.leadFirst" /><br /><Text k="intro.leadSecond" /></p>
    <div class="illustration" aria-hidden="true">
      <div class="paper paper-back"></div>
      <div class="paper paper-front">
        <Text class="paper-date" k="intro.paper" />
        <span class="paper-line long"></span><span class="paper-line"></span><span class="paper-line short"></span><span class="paper-flower">✳</span>
      </div>
    </div>
    <Text as="p" class="intro-foot" k="intro.foot" />
  </div>
  <div class="auth-card">
    <Text class="pill" k="auth.badge" />
    <Text as="h2" k="auth.title" />
    <Text as="p" class="muted" k="auth.description" />
    <form id="loginForm">
      <Text as="label" for="email" k="auth.email" />
      <input id="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" />
      <Text as="label" for="password" k="auth.password" />
      <input id="password" type="password" autocomplete="current-password" data-i18n-placeholder="auth.passwordPlaceholder" placeholder={t('auth.passwordPlaceholder')} required />
      <Text as="button" id="loginBtn" class="primary" type="submit" k="auth.login" />
      <Text as="button" id="signupBtn" class="secondary" type="button" k="auth.signup" />
    </form>
    <p class="fine-print"><Text k="auth.fineFirst" /><br /><Text k="auth.fineSecond" /></p>
  </div>
</section>
