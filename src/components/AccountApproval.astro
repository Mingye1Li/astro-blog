---
import Text from './Text.astro';
---
<section id="adminPanel" class="admin-panel" hidden aria-labelledby="adminTitle">
  <div class="list-heading">
    <div><Text as="p" class="eyebrow" k="admin.eyebrow" /><Text as="h2" id="adminTitle" k="admin.title" /></div>
    <Text as="button" id="refreshAccountsBtn" class="secondary compact" type="button" k="admin.refresh" />
  </div>
  <Text as="p" class="muted" k="admin.description" />
  <p id="accountsState" role="status"></p>
  <div id="accounts"></div>
</section>
