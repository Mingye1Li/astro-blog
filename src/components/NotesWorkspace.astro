---
import Text from './Text.astro';
import { fallback as t } from '../i18n/resources.js';
---
<div id="noteWorkspace" class="workspace-grid" hidden role="tabpanel" aria-labelledby="notesTab" tabindex="0">
  <section class="editor-card">
    <Text as="p" class="eyebrow" k="workspace.capture" />
    <Text as="h2" id="editorTitle" k="workspace.newNote" />
    <form id="noteForm">
      <Text as="label" for="noteTitle" k="workspace.titleLabel" />
      <input id="noteTitle" data-i18n-placeholder="workspace.titlePlaceholder" placeholder={t('workspace.titlePlaceholder')} required maxlength="120" />
      <Text as="label" id="noteBodyLabel" for="noteBody" k="workspace.bodyLabel" />
      <Text as="p" id="markdownHelp" class="markdown-help" k="markdown.help" />
      <textarea id="noteBody" rows="9" data-i18n-placeholder="workspace.bodyPlaceholder" placeholder={t('workspace.bodyPlaceholder')} maxlength="20000"></textarea>
      <p id="noteLength" class="markdown-length"></p>
      <div class="actions">
        <Text as="button" id="saveBtn" class="primary" type="submit" k="workspace.save" />
        <Text as="button" id="cancelBtn" class="secondary" type="button" hidden k="workspace.cancel" />
      </div>
    </form>
  </section>
  <section aria-labelledby="notesTitle">
    <div class="list-heading"><Text as="h2" id="notesTitle" k="workspace.notes" /><Text as="button" id="refreshBtn" class="text-button" type="button" k="workspace.refresh" /></div>
    <Text as="p" id="notesState" class="empty-state" k="workspace.loading" />
    <div id="notes"></div>
  </section>
</div>
