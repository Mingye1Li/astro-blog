---
import Text from './Text.astro';
import AccessPanel from './AccessPanel.astro';
import AccountApproval from './AccountApproval.astro';
import NotesWorkspace from './NotesWorkspace.astro';
const { page = 'home' } = Astro.props;
---
<section id="dashboard" hidden>
  <div class="workspace-header">
    <div><Text as="p" class="eyebrow" k="workspace.eyebrow" /><h1><Text k={page === 'admin' ? 'admin.eyebrow' : 'workspace.title'} /><span class="accent">.</span></h1><p id="welcome" class="muted"></p></div>
    <Text as="button" id="logoutBtn" class="secondary compact" k="auth.logout" />
  </div>
  <AccessPanel />
  {page === 'admin' && <AccountApproval />}
  {page === 'notes' && <NotesWorkspace />}
</section>
