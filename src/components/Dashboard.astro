---
import Text from './Text.astro';
import AccessPanel from './AccessPanel.astro';
import AccountApproval from './AccountApproval.astro';
import NotesWorkspace from './NotesWorkspace.astro';
---
<section id="dashboard" hidden>
  <div class="workspace-header">
    <div><Text as="p" class="eyebrow" k="workspace.eyebrow" /><h1><Text k="workspace.title" /><span class="accent">.</span></h1><p id="welcome" class="muted"></p></div>
    <Text as="button" id="logoutBtn" class="secondary compact" k="auth.logout" />
  </div>
  <AccessPanel />
  <div id="workspaceTabs" class="workspace-tabs" role="tablist" data-i18n-aria-label="navigation.label" aria-label="工作区" hidden>
    <Text as="button" id="notesTab" type="button" role="tab" aria-selected="true" aria-controls="noteWorkspace" k="navigation.notes" />
    <Text as="button" id="adminTab" type="button" role="tab" aria-selected="false" aria-controls="adminPanel" tabindex="-1" hidden k="navigation.admin" />
  </div>
  <AccountApproval />
  <NotesWorkspace />
</section>
