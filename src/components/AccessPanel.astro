---
import Text from './Text.astro';
---
<section id="accessPanel" class="editor-card" role="status">
  <Text id="accessBadge" class="pill" k="access.checkingBadge" />
  <Text as="h2" id="accessTitle" k="access.checkingTitle" />
  <Text as="p" id="accessDescription" class="muted" k="access.checkingDescription" />
  <Text as="button" id="checkAccessBtn" class="secondary compact" type="button" k="access.refresh" />
</section>
