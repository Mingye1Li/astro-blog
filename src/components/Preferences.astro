---
import { fallback as t } from '../i18n/resources.js';
---
<div class="preferences">
  <label class="preference" for="languageSelect">
    <span class="sr-only" data-i18n="preferences.language">{t('preferences.language')}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5h12M9 3v2M6 5c0 6 4 9 7 10M12 5c0 6-5 10-9 11M14 21l4-10 4 10M15.5 17h5" /></svg>
    <select id="languageSelect" data-i18n-title="preferences.language" title={t('preferences.language')}>
      <option value="zh-CN" lang="zh-CN">简体中文</option>
      <option value="en" lang="en">English</option>
    </select>
  </label>
  <label class="preference" for="themeSelect">
    <span class="sr-only" data-i18n="preferences.theme">{t('preferences.theme')}</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14a8.5 8.5 0 0 1-10.5-10.5A8.5 8.5 0 1 0 20.5 14Z" /><path d="M17 3v4m-2-2h4M21 8v2m-1-1h2" /></svg>
    <select id="themeSelect" data-set-theme data-key="liubai-theme" data-i18n-title="preferences.theme" title={t('preferences.theme')}>
      <option value="" data-i18n="preferences.system">{t('preferences.system')}</option>
      <option value="light" data-i18n="preferences.light">{t('preferences.light')}</option>
      <option value="dark" data-i18n="preferences.dark">{t('preferences.dark')}</option>
    </select>
  </label>
</div>
