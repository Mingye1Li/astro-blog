---
import '../styles/global.css';
import Preferences from '../components/Preferences.astro';
import { fallback as t } from '../i18n/resources.js';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="登录你的私人笔记空间。" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <title>{t('page.title')}</title>
    <script is:inline>
      // Apply the saved theme before the first paint; system mode is handled by CSS.
      try {
        const theme = localStorage.getItem('liubai-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch { /* System theme works even when storage is unavailable. */ }
    </script>
  </head>
  <body>
    <header>
      <a class="brand" href="/"><span class="mark" aria-hidden="true">留</span><span data-i18n="brand.name">{t('brand.name')}</span><span class="brand-sub" data-i18n="brand.sub">{t('brand.sub')}</span></a>
      <Preferences />
    </header>
    <main><slot /></main>
    <footer><span data-i18n="footer.brand">{t('footer.brand')}</span><span data-i18n="footer.note">{t('footer.note')}</span></footer>
  </body>
</html>
